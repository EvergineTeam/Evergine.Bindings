---
import "../styles/global.css";
import data from "../data/agents-data.json";
import { when } from "../lib/format";

interface Props { title: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="Status and agent activity across the Evergine binding repositories." />
  {/* Runs before the first paint so a stored choice never flashes the other
      theme. Nothing is set when the reader has not chosen, which leaves the
      palette to prefers-color-scheme. */}
  <script is:inline>
    try {
      const stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.dataset.theme = stored;
      }
    } catch (e) {
      /* Private browsing can throw on localStorage; the OS preference still applies. */
    }
  </script>
</head>
<body>
  <div class="wrap">
    <header>
      <h1><a href={base}>Evergine Bindings</a></h1>
      <span class="stamp">updated {when(data.generated_at)}</span>
      <button type="button" class="theme" aria-label="Switch between light and dark theme" title="Switch theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </header>
    <slot />
    <footer>
      Built from <code>metrics/collect-metrics.py</code> in
      <a href="https://github.com/EvergineTeam/Evergine.Bindings">EvergineTeam/Evergine.Bindings</a>,
      over a {data.window_days}-day window.<br />
      Read-only: every figure comes from the GitHub API, <code>gh aw audit</code> or nuget.org.
      No binding repository writes anything for this page.
    </footer>
  </div>
  <script is:inline>
    (function () {
      const root = document.documentElement;
      const system = window.matchMedia("(prefers-color-scheme: light)");

      const shown = () => root.dataset.theme || (system.matches ? "light" : "dark");

      document.querySelector(".theme")?.addEventListener("click", () => {
        const next = shown() === "dark" ? "light" : "dark";
        const followsSystem = next === (system.matches ? "light" : "dark");

        try {
          // Choosing whatever the system already says drops the override, so the
          // page goes back to following the OS instead of pinning that value.
          if (followsSystem) {
            localStorage.removeItem("theme");
          } else {
            localStorage.setItem("theme", next);
          }
        } catch (e) {
          /* Ignored: the theme still applies for this page view. */
        }

        if (followsSystem) {
          delete root.dataset.theme;
        } else {
          root.dataset.theme = next;
        }
      });
    })();
  </script>
</body>
</html>
