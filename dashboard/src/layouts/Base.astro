---
import "../styles/global.css";
import data from "../data/agents-data.json";
import { when } from "../lib/format";

interface Props { title: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="Status and agent activity across the Evergine binding repositories." />
</head>
<body>
  <div class="wrap">
    <header>
      <h1><a href={base}>Evergine Bindings</a></h1>
      <span class="stamp">updated {when(data.generated_at)}</span>
    </header>
    <slot />
    <footer>
      Built from <code>metrics/collect-metrics.py</code> in
      <a href="https://github.com/EvergineTeam/Evergine.Bindings">EvergineTeam/Evergine.Bindings</a>,
      over a {data.window_days}-day window.<br />
      Read-only: every figure comes from the GitHub API, <code>gh aw audit</code> or nuget.org.
      No binding repository writes anything for this page.
    </footer>
  </div>
</body>
</html>
